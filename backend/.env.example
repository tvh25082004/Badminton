# ==== Badminton API — biến môi trường ====
# Copy thành .env và chỉnh giá trị. KHÔNG commit .env thật.
PORT=4000
NODE_ENV=development
APP_NAME=badminton-api

# CORS: danh sách origin cách nhau dấu phẩy, hỗ trợ *.domain
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,*.vercel.app

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=25432
DB_USER=badminton
DB_PASSWORD=badminton_dev
DB_NAME=badminton
# Bật tự tạo bảng khi chưa có migration (mặc định chỉ bật ở dev)
DB_SYNC=true

# JWT (bắt buộc đổi secret khi deploy thật)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# OTP — SMS_MOCK=true trả mã trong response (CHỈ dev/demo)
SMS_MOCK=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60

# Quick match QR động
QR_WINDOW_SECONDS=10
QR_INVITE_TTL_SECONDS=300
QR_HMAC_SECRET=change-me-qr-secret

# Rate limit
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
