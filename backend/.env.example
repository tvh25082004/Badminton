# Server
PORT=4000
NODE_ENV=development
APP_NAME=badminton-api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DB_HOST=localhost
DB_PORT=25432
DB_USER=badminton
DB_PASSWORD=badminton_dev
DB_NAME=badminton

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# OTP / SMS
SMS_MOCK=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60

# Quick match QR
QR_WINDOW_SECONDS=10
QR_INVITE_TTL_SECONDS=300
QR_HMAC_SECRET=change-me-qr-hmac-secret-32chars-min

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
