# Production env — copy thành .env rồi ĐỔI HẾT các secret
PORT=4000
NODE_ENV=production
APP_NAME=badminton-api

# DB trỏ tới service 'postgres' bên trong docker network (không phải 25432)
DB_HOST=postgres
DB_PORT=5432
DB_USER=badminton
DB_PASSWORD=DO-DOI-MAT-KHAU-NGAY
DB_NAME=badminton
# Chưa có migration → bật auto-sync bảng trên DB mới
DB_SYNC=true

# ĐỔI secret (ít nhất 32 ký tự ngẫu nhiên)
JWT_ACCESS_SECRET=doi-access-secret-32-ky-tu-ngau-nhien
JWT_REFRESH_SECRET=doi-refresh-secret-32-ky-tu-ngau-nhien
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# SMS mock — API trả mã OTP trong response. Tắt khi tích hợp SMS thật.
SMS_MOCK=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60

# Quick match QR động
QR_WINDOW_SECONDS=10
QR_INVITE_TTL_SECONDS=300
QR_HMAC_SECRET=doi-qr-secret-32-ky-tu

# CORS: thêm domain Vercel/thật vào đây
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,*.vercel.app

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
